{
  "functions": {
    "api/arca.js": {
      "maxDuration": 120
    },
    "api/andreani.js": {
      "maxDuration": 60
    },
    "api/orders.js": {
      "maxDuration": 90
    },
    "api/stock.js": {
      "maxDuration": 90
    },
    "api/inventory.js": {
      "maxDuration": 90
    },
    "api/meta.js": {
      "maxDuration": 60
    },
    "api/copilot.js": {
      "maxDuration": 60
    },
    "api/update-shipping.js": {
      "maxDuration": 60
    },
    "api/check-expiring.js": {
      "maxDuration": 60
    },
    "api/check-payments.js": {
      "maxDuration": 60
    },
    "api/tareas.js": {
      "maxDuration": 60
    },
    "api/shopify-rates.js": {
      "maxDuration": 15
    },
    "api/tiktok-ads.js": {
      "maxDuration": 120
    },
    "api/mcp.js": {
      "maxDuration": 90
    },
    "api/demo.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp?route=mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp?route=prm" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/mcp?route=prm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp?route=asm" },
    { "source": "/.well-known/oauth-authorization-server/mcp", "destination": "/api/mcp?route=asm" },
    { "source": "/oauth/register", "destination": "/api/mcp?route=register" },
    { "source": "/oauth/authorize", "destination": "/api/mcp?route=authorize" },
    { "source": "/oauth/token", "destination": "/api/mcp?route=token" },
    { "source": "/oauth/revoke", "destination": "/api/mcp?route=revoke" },
    {
      "source": "/__/auth/:path*",
      "destination": "https://soluna-gestion.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://soluna-gestion.firebaseapp.com/__/firebase/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/check-expiring",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/check-payments",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/meta?action=cron_run_all",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/orders?action=warm_margenes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/stock?action=warm_all",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/update-shipping?action=track_all",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/tareas?action=cron_deadlines",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/arca?action=cron_autopilot",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/pagos-cal?action=cron_avisos",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/tareas?action=cron_purgar_cuentas",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/integrations?platform=shopify&action=cron_refresh_tokens",
      "schedule": "*/30 * * * *"
    }
  ]
}
