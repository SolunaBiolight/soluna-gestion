{
  "functions": {
    "api/arca.js": { "maxDuration": 120 },
    "api/orders.js": { "maxDuration": 90 },
    "api/stock.js": { "maxDuration": 60 },
    "api/inventory.js": { "maxDuration": 90 },
    "api/meta.js": { "maxDuration": 60 },
    "api/copilot.js": { "maxDuration": 60 },
    "api/update-shipping.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://soluna-gestion.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://soluna-gestion.firebaseapp.com/__/firebase/:path*" }
  ],
  "crons": [
    { "path": "/api/check-expiring", "schedule": "0 10 * * *" },
    { "path": "/api/meta?action=cron_run_all", "schedule": "0 11 * * *" },
    { "path": "/api/orders?action=warm_margenes", "schedule": "*/5 * * * *" },
    { "path": "/api/stock?action=warm_all", "schedule": "*/15 * * * *" },
    { "path": "/api/update-shipping?action=track_all", "schedule": "*/30 * * * *" }
  ]
}
